# 明文待译表与脚本必须锁 LF：本机 core.autocrlf=true 会把它们换成 CRLF，
# 导致 GitHub Action（Linux）与本地重新生成的产物字节不一致。
text/*.jsonl    text eol=lf
text/*.json     text eol=lf
text/*.md       text eol=lf
tools/*.py      text eol=lf
docs/*.md       text eol=lf
*.md            text eol=lf
.gitignore      text eol=lf
LICENSE         text eol=lf
packaging/*.txt text eol=lf
payload/*.json  text eol=lf

# workflow 同样锁 LF：CRLF 虽能被 GitHub 解析，但会让本地 diff 噪声变大
.github/**     text eol=lf

# C++ 源码与 def：LF 便于 diff；MSVC 两种都能编
src/*.cpp       text eol=lf
src/*.h         text eol=lf
*.def           text eol=lf
*.cpp           text eol=lf
*.h             text eol=lf

# 批处理必须 CRLF，cmd.exe 对 LF 的 goto/label 解析有坑
*.bat           text eol=crlf

# 清单是给 Excel 打开的 utf-8-sig CSV，换行交给 Git 自动处理即可
inventory/*.csv text

# VS 工程文件保持平台习惯
*.sln           text eol=crlf
*.vcxproj       text eol=crlf
*.vcxproj.filters text eol=crlf

# 二进制 / 游戏素材（不应入库，保险起见声明）
*.dll           binary
*.zip           binary
*.exe           binary
*.icd           binary
*.hpi           binary
*.gaf           binary
